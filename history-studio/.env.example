# Copy to .env (gitignored) and fill in. Never commit real keys.

# --- Speech (narration) -------------------------------------------------
# Any OpenAI-compatible /audio/speech endpoint. AI Credits (aicredits.in) example:
SPEECH_BASE_URL=https://api.aicredits.in/v1
SPEECH_API_KEY=sk-REPLACE_ME
SPEECH_MODEL=openai/gpt-4o-mini-tts
SPEECH_VOICE=cedar
# SPEECH_ENGINE: openai-compatible | elevenlabs | kokoro (free local Kokoro-82M voice, no API calls).
SPEECH_ENGINE=openai-compatible
KOKORO_VOICE=bm_george

# --- ElevenLabs (used when SPEECH_ENGINE=elevenlabs) ----------------------
# Key from elevenlabs.io > Settings > API keys. Prefer setting it as an environment variable in the
# cloud environment's settings rather than in a file. Needs network access to api.elevenlabs.io.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
# Chosen with `studio voices` + `studio audition`; leave empty until then.
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=
# v3 stability: 0.0 Creative, 0.5 Natural (default), 1.0 Robust (ignores most delivery tags)
ELEVENLABS_STABILITY=0.5
# mp3_44100_192 needs the Creator plan or above; pcm/wav 44.1 kHz needs Pro.
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Hard cap on credits per episode, including auditions, tests and retakes. Credits are never bought automatically.
ELEVENLABS_CREDIT_CAP=10000

# --- Text (optional drafting stage; off unless TEXT_ENABLED=true) --------
TEXT_ENABLED=false
TEXT_BASE_URL=https://api.aicredits.in/v1
TEXT_API_KEY=sk-REPLACE_ME
TEXT_MODEL=openai/gpt-4o-mini

# --- Transcription (optional QA check of the final mix) ------------------
STT_ENABLED=false
STT_BASE_URL=https://api.aicredits.in/v1
STT_API_KEY=sk-REPLACE_ME
STT_MODEL=openai/whisper-1

# --- Optional image generation (not used by default) ---------------------
IMAGE_ENABLED=false
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# --- Optional demand research via the official YouTube Data API v3 -------
# (Scraping YouTube is not permitted by its Terms of Service.)
YOUTUBE_API_KEY=

# --- Budget and output ----------------------------------------------------
EPISODE_BUDGET_INR=100
OUTPUT_DIR=episodes
LANGUAGE=en
RENDER_CONCURRENCY=4
# Optional: path to a Chrome/Chromium headless shell for Remotion
BROWSER_EXECUTABLE=
