# Copy to .env (gitignored) and fill in. Never commit real keys.

# --- Speech (narration) -------------------------------------------------
# Any OpenAI-compatible /audio/speech endpoint. AI Credits (aicredits.in) example:
SPEECH_BASE_URL=https://api.aicredits.in/v1
SPEECH_API_KEY=sk-REPLACE_ME
SPEECH_MODEL=openai/gpt-4o-mini-tts
SPEECH_VOICE=cedar
# Set SPEECH_ENGINE=kokoro to use the free local Kokoro-82M voice instead (no API calls).
SPEECH_ENGINE=openai-compatible
KOKORO_VOICE=bm_george

# --- Text (optional drafting stage; off unless TEXT_ENABLED=true) --------
TEXT_ENABLED=false
TEXT_BASE_URL=https://api.aicredits.in/v1
TEXT_API_KEY=sk-REPLACE_ME
TEXT_MODEL=openai/gpt-4o-mini

# --- Transcription (optional QA check of the final mix) ------------------
STT_ENABLED=false
STT_BASE_URL=https://api.aicredits.in/v1
STT_API_KEY=sk-REPLACE_ME
STT_MODEL=openai/whisper-1

# --- Optional image generation (not used by default) ---------------------
IMAGE_ENABLED=false
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# --- Optional demand research via the official YouTube Data API v3 -------
# (Scraping YouTube is not permitted by its Terms of Service.)
YOUTUBE_API_KEY=

# --- Budget and output ----------------------------------------------------
EPISODE_BUDGET_INR=100
OUTPUT_DIR=episodes
LANGUAGE=en
RENDER_CONCURRENCY=4
# Optional: path to a Chrome/Chromium headless shell for Remotion
BROWSER_EXECUTABLE=
